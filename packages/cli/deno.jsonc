{
  "name": "@vanaware/syntaxmesh-cli",
  "version": "0.0.2",
  "description": "SyntaxMesh CLI — tj3-equivalent multi-runtime command line (ADR 034)",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext",
      "deno.ns",
      "deno.unstable"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.3.1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "@vanaware/syntaxmesh": "../../packages/core/mod.ts"
  },
  "tasks": {
    "run": "deno run --allow-read --allow-write --allow-env src/cli.ts",
    "check": "deno check src/**/*.ts tests/**/*.ts scripts/**/*.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run tests/",
    "tests": "deno task check && deno task test",
    "compile": "deno compile --node-modules-dir=none --allow-read --allow-write --allow-env --output dist/syntaxmesh src/cli.ts",
    "build:node": "deno run --allow-read --allow-write --allow-run scripts/bundle-node.ts",
    "build": "deno task compile && deno task build:node"
  },
  "exports": {
    ".": "./src/cli.ts",
    "./io": "./src/io.ts",
    "./options": "./src/options.ts"
  }
}

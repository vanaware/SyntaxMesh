              "task": "effortTask",
              "workDays": 20,
              "remainingDays": 0,
              "status": {
                "alertLevel": 0,
                "headline": "Progresso normal"
              }
            }
          ]
        }
      ],
      "expected": {
        "messages": [],
        "sheets": [
          {
            "resource": "dev",
            "start": "2026-01-01",
            "end": "2026-01-29",
            "percentageUsed": false,
            "totalSlots": 160,
            "records": [
              {
                "task": "effortTask",
                "work": 160,
                "remaining": 0,
                "expectedEnd": null,
                "status": {
                  "alertLevel": 0,
                  "headline": "Progresso normal"
                }
              }
            ]
          }
        ]
      }
    },

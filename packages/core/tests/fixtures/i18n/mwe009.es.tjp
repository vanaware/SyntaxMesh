language "es"

proyecto prj "Macros Demo" "1.0" 2024-12-01 - 2024-12-31 {
  formatohora "%Y-%m-%d"
  ahora 2024-12-01
  moneda "USD"
}

/* 1. Resources */
recurso dev1 "Alice"
recurso dev2 "Bob"
recurso qa1 "Charlie"

/* 2. Define Macros (Templates) */

# Macro A: Simple Text Replacement
macro assign_team [
  asignar dev1
  asignar dev2
]

# Macro B: Parameterized Task Template
# ${1} = Task ID
# ${2} = Task Name
# ${3} = Effort
# ${4} = Extra attributes (Dependencies, etc.) - INSERTED FIRST
macro feature_task [
  tarea ${1} "${2}" {
    # FIX: Insert dependencies here, BEFORE defining sub-tasks
    ${4}

    # Sub-task 1: Implementation
    tarea impl "Implementation" {
      esfuerzo ${3}d
      ${assign_team}
    }

    # Sub-task 2: Testing
    tarea test "QA Testing" {
      depende !impl
      esfuerzo 1d
      asignar qa1
    }
  }
]

/* 3. Using Macros in the Project */
tarea proyecto "Software Release" {

  # Feature A: No dependencies.
  # We pass an empty string "" as the 4th argument.
  ${feature_task "feat_a" "Login System" "5" ""}

  # Feature B: Depends on Feature A.
  # We pass the dependency string as the 4th argument.
  ${feature_task "feat_b" "User Profile" "3" "depends !feat_a"}
}

/* 4. Report */
infotarea "MacroResult" {
  formatos html
  titular "Project Generated via Macros"
  columnas bsi, name, inicio, fin, esfuerzo, chart
}

# 26.8 (F21¹) — fixture de equivalência de AST (ADR 023).
# Tradução mecânica: apenas keywords variam entre idiomas; ids, strings,
# datas e literais são idênticos. Gerado por .tmp/gen-i18n-fixtures.ts.
language "en"

project tr "Task Report" "1.0" 2026-01-01 - 2026-03-31 {
  timezone "UTC"
  now 2026-01-01
}
task items "Breakdown" {
  start 2026-01-05
  task plan "Plan" { length 3d }
  task exec "Execute" { length 5d depends !plan }
}
taskreport plan "My Tasks" {
  formats html
  headline "Project Plan"
  columns bsi { title "WBS" }, name, start, end
  hidetask ~isleaf()
  sorttasks name.up
}

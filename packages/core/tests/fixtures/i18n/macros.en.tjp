# 26.8 (F21¹) — fixture de equivalência de AST (ADR 023).
# Tradução mecânica: apenas keywords variam entre idiomas; ids, strings,
# datas e literais são idênticos. Gerado por .tmp/gen-i18n-fixtures.ts.
language "en"

project mc "Macros" "1.0" 2026-01-01 - 2026-03-31 {
  timezone "UTC"
  now 2026-01-01
}
macro allocateGroup [
  allocate tux1, tux2
]
resource tux1 "Tux1"
resource tux2 "Tux2"
task t1 "Task1" {
  start ${projectstart}
}
task t2 "Task2" {
  depends !t1
  effort 20d
  ${allocateGroup}
}

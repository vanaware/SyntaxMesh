# 26.8 (F21¹) — fixture de equivalência de AST (ADR 023).
# Tradução mecânica: apenas keywords variam entre idiomas; ids, strings,
# datas e literais são idênticos. Gerado por .tmp/gen-i18n-fixtures.ts.
language "es"

proyecto rr "Resource Report" "1.0" 2026-01-01 - 2026-03-31 {
  zonahoraria "UTC"
  ahora 2026-01-01
}
recurso tux "Tux" { tarifa 300 }
recurso konqui "Konqui" { tarifa 200 }
tarea t "T" {
  inicio 2026-01-05
  esfuerzo 2d
  asignar tux, konqui
}
inforecurso usage "Usage" {
  formatos csv
  columnas name, esfuerzo
  ocultarrecurso ~isleaf()
  ordenarrecursos name.up
}

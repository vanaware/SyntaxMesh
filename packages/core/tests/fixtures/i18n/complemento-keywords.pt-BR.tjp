language "pt-BR"
projeto prj "Test" "1.0" 2026-01-01 - 2026-12-31
material steel "Steel" {
  unit "kg"
  unitprice 2
}
tarefa t1 "T1" {
  esforço 2d
  base_temporal duration
  material steel 10 precaounitario 3
  atribuição material steel quantidade 5 precaounitario 4 em 2026-01-06
  lançamento 2026-01-05 "Entry" {
    foto "a.png" {
      legenda "Cap"
      alinhar left
      largura 100
      alt "Alt"
    }
    formato markdown
  }
}
relatoriodecomposicao br "B" {
  agruparpore tarefa
  colunas materiais, valores, fotos, base_temporal
  ocultarlancamento isleaf()
}
relatoriodiarioobra rdo "R" {
  período 2026-01-01 - 2026-01-31
  agruparpore date
  maxfotos 5
  colunas name
}
relatoriomaterial mr "M" {
  colunas name, nota
  formatos html, csv, json
  ordenarpor name.up, note
}

# 26.8 (F21¹) — fixture de equivalência de AST (ADR 023).
# Tradução mecânica: apenas keywords variam entre idiomas; ids, strings,
# datas e literais são idênticos. Gerado por .tmp/gen-i18n-fixtures.ts.
language "pt-BR"

projeto rr "Resource Report" "1.0" 2026-01-01 - 2026-03-31 {
  fusohorario "UTC"
  agora 2026-01-01
}
recurso tux "Tux" { taxa 300 }
recurso konqui "Konqui" { taxa 200 }
tarefa t "T" {
  início 2026-01-05
  esforço 2d
  alocar tux, konqui
}
relatoriorecurso usage "Usage" {
  formatos csv
  colunas name, esforço
  ocultarrecurso ~isleaf()
  ordenarrecursos name.up
}

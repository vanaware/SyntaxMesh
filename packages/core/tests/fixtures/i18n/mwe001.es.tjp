language "es"

/* 1. Project Header: ID, Name, Version, and Timeframe */
proyecto prj "My First Project" "1.0" 2024-06-01 - 2024-06-30 {
  formatohora "%Y-%m-%d"
  ahora 2024-06-01
}

/* 2. Resources: Who is doing the work? */
recurso dev "Foad"

/* 3. Tasks: What needs to be done? */
tarea main "Main Project" {
  
  tarea t1 "Design Phase" {
    esfuerzo 2d       # Takes 2 days of work
    asignar dev    # Assigned to Foad
  }

  tarea t2 "Implementation" {
    esfuerzo 3d
    asignar dev
    depende !t1     # Cannot start until t1 is finished
  }

  tarea t3 "Testing" {
    esfuerzo 1d
    asignar dev
    depende !t2     # Cannot start until t2 is finished
  }
}

/* 4. Reports: Define what you want to see */
infotarea "Plan" {
  formatos html
  titular "My Project Gantt Chart"
  
  # The 'chart' column generates the visual Gantt bars
  columnas bsi { titulo 'WBS' }, name, inicio, fin, chart
}
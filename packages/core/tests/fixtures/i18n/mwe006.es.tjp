language "es"

proyecto prj "Tracking Progress" "1.0" 2024-10-01 - 2024-10-31 {
  formatohora "%Y-%m-%d"

  # IMPORTANT: 'now' simulates the current date.
  # We assume we are in the middle of the project (Oct 15th).
  ahora 2024-10-15
  moneda "USD"
}

/* 1. Resources */
recurso dev "Developer" {
  tarifa 400.0
}

/* 2. Tasks (The Plan) */
tarea proyecto "Software Project" {

  tarea t1 "Requirements" {
    # This task was scheduled for the first week
    inicio 2024-10-01
    esfuerzo 5d
    asignar dev

    # Method A: Simple Completion
    # We simply state this task is 100% finished.
    completo 100
  }

  tarea t2 "Implementation" {
    # This task starts after t1
    depende !t1
    esfuerzo 10d
    asignar dev

    # Journal entries help document *why* things happened
    asiento 2024-10-10 "Started implementation phase"
  }
}

/* 3. Tracking Actuals (The Reality) */
# We use 'supplement' to add bookings to the resource defined above.
# This simulates importing a timesheet.
complementar recurso dev {

  # Syntax: booking <task_id> <start> - <end>
  # 'dev' worked 3 days on 't2' so far.
  asignacion project.t2 2024-10-08-09:00 - 2024-10-08-17:00
  asignacion project.t2 2024-10-09-09:00 - 2024-10-09-17:00
  asignacion project.t2 2024-10-10-09:00 - 2024-10-10-17:00
}

/* 4. Status Report */
infotarea "StatusReport" {
  formatos html
  titular "Project Status Report (as of 2024-10-15)"

  # FIX: Flatten the column list. Do not nest columns inside 'chart'.
  columnas bsi, name, inicio, fin, esfuerzo, esfuerzohecho, esfuerzorestante, completo, estado, chart
}

{
  "name": "@vanaware/syntaxmesh-vscode",
  "version": "0.0.2",
  "description": "SyntaxMesh VS Code extension — editor tooling (ADR 035, Fase 22)",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "webworker",
      "esnext",
      "deno.ns",
      "deno.unstable"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "@std/testing/time": "jsr:@std/testing@^1/time",
    // Núcleos puros do core (workspace, caminho relativo como no CLI):
    // `lsp-core` = serviços LSP + registerLspServer; `doc-core` = SyntaxCore
    // (dados de highlight consumidos pela grammar TextMate).
    "@vanaware/syntaxmesh/lsp-core": "../core/src/lsp/mod.ts",
    "@vanaware/syntaxmesh/doc-core": "../core/src/docgen/mod.ts",
    // Barril completo do core (P4 — daemon): `execute` + tipos do envelope
    // (`ExecutionRequest`/`ExecutionResult`) + `scanIncludeReferences`/
    // `normalizeInputPath`. Mesmo caminho relativo do CLI (ADR 034/035).
    "@vanaware/syntaxmesh": "../core/mod.ts",
    // API `vscode`: só tipos (`@types/vscode`); o runtime é provido pelo
    // Extension Host e fica `--external vscode` no bundle (22.4.7).
    "vscode": "npm:@types/vscode@^1.90.0",
    // Adaptadores de transporte por host (node = desktop IPC, browser = Web
    // Worker). A inteligência LSP mora no core; aqui só bootstrap.
    "vscode-languageclient/node": "npm:vscode-languageclient@^9.0.1/node",
    "vscode-languageclient/browser": "npm:vscode-languageclient@^9.0.1/browser",
    "vscode-languageserver/node": "npm:vscode-languageserver@^9.0.1/node",
    "vscode-languageserver/browser": "npm:vscode-languageserver@^9.0.1/browser"
  },
  "tasks": {
    "check": "deno check src/**/*.ts tests/**/*.ts scripts/**/*.ts",
    "test": "deno test --allow-read --allow-write --allow-env tests/",
    "tests": "deno task check && deno task test",
    // Gera os assets de linguagem (grammar/language-config/snippets) a partir
    // dos geradores puros (22.3.5).
    "generate": "deno run --allow-read --allow-write scripts/generate-grammar.ts",
    // Regenera os fixtures golden da grammar (22.3.6) após mudança intencional.
    "generate:snapshots": "deno run --allow-read --allow-write scripts/generate-snapshots.ts",
    // Bundle dos 4 artefatos via `deno bundle` (22.4.7; ADR 034/CLI precedent).
    "build": "deno run --allow-read --allow-write --allow-run --allow-env scripts/build.ts",
    // `deno doc --lint` em ratchet (ADR 041): a entrada é o `exports` deste
    // pacote. Pacote novo = piso zero (JSDoc inglês completo, sem dívida).
    "lint:doc": "deno run --allow-read --allow-run --allow-write --allow-env ../../scripts/lint-doc.ts src/extension.node.ts",
    "lint:doc:update": "deno run --allow-read --allow-run --allow-write --allow-env ../../scripts/lint-doc.ts --update src/extension.node.ts"
  },
  "exports": {
    ".": "./src/extension.node.ts"
  },
  "exclude": ["dist/"]
}

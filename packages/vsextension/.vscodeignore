# VS Code extension packaging exclusions (22.2.4).
# The .vsix ships only the manifest, the bundled dist/*.js and the language
# assets (syntaxes/, snippets/, language-configuration.json). Source, tests,
# build scripts and Deno config stay out (ADR 035 §7; plan §10).
.vscode/**
.tmp/**
src/**
tests/**
scripts/**
node_modules/**
deno.jsonc
deno.lock
dist/**/*.map
.gitignore
{
  "name": "syntaxmesh-vscode",
  "displayName": "SyntaxMesh",
  "description": "SyntaxMesh language support: highlight, diagnostics, hover, completion and navigation for .smx (native) and TaskJuggler-compatible .tjp/.tji.",
  "version": "0.0.2",
  "publisher": "vanaware",
  "license": "GPL-2.0-only",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "syntaxmesh",
    "taskjuggler",
    "project management",
    "tjp",
    "smx"
  ],
  "main": "./dist/extension.node.js",
  "browser": "./dist/extension.web.js",
  "activationEvents": [
    "onLanguage:syntaxmesh",
    "onView:syntaxmesh.projectTree"
  ],
  "contributes": {
    "languages": [
      {
        "id": "syntaxmesh",
        "aliases": [
          "SyntaxMesh",
          "syntaxmesh"
        ],
        "extensions": [
          ".smx",
          ".tjp",
          ".tji"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "syntaxmesh",
        "scopeName": "source.syntaxmesh",
        "path": "./syntaxes/syntaxmesh.tmLanguage.json"
      },
      {
        "language": "syntaxmesh",
        "scopeName": "source.syntaxmesh.tji",
        "path": "./syntaxes/syntaxmesh-tji.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "syntaxmesh",
        "path": "./snippets/syntaxmesh.json"
      }
    ],
    "commands": [
      {
        "command": "syntaxmesh.addProject",
        "title": "Add Project to Daemon",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.reloadProject",
        "title": "Reload Project",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.removeProject",
        "title": "Remove Project from Daemon",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.listProjects",
        "title": "List Projects",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.generateReport",
        "title": "Generate Report",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.exportTjp",
        "title": "Export .tjp",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.switchLanguage",
        "title": "Switch Language",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.showProjectTree",
        "title": "Show Project Tree",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.openManual",
        "title": "Open Manual",
        "category": "SyntaxMesh"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "syntaxmesh",
          "title": "SyntaxMesh",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "syntaxmesh": [
        {
          "id": "syntaxmesh.projectTree",
          "name": "Project Explorer"
        }
      ]
    },
    "configuration": {
      "title": "SyntaxMesh",
      "properties": {
        "syntaxmesh.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the SyntaxMesh language server."
        },
        "syntaxmesh.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of diagnostics reported per document."
        },
        "syntaxmesh.locale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pt-BR",
            "es"
          ],
          "default": "auto",
          "description": "Default input language when the file has no 'language' directive. The file directive always takes precedence."
        },
        "syntaxmesh.report.defaultFormat": {
          "type": "string",
          "default": "html",
          "description": "Preferred report format in the Generate Report command."
        }
      }
    }
  }
}

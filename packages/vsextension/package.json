{
  "name": "syntaxmesh-vscode",
  "displayName": "SyntaxMesh",
  "description": "SyntaxMesh language support: highlight, diagnostics, hover, completion and navigation for .smx (native) and TaskJuggler-compatible .tjp/.tji.",
  "version": "0.0.2",
  "publisher": "vanaware",
  "license": "GPL-2.0-only",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "syntaxmesh",
    "taskjuggler",
    "project management",
    "tjp",
    "smx"
  ],
  "main": "./dist/extension.node.js",
  "browser": "./dist/extension.web.js",
  "files": [
    "assets/**",
    "dist/**",
    "images/**",
    "language-configuration.json",
    "snippets/**",
    "syntaxes/**",
    "LICENSE"
  ],
  "activationEvents": [
    "onLanguage:syntaxmesh",
    "onView:syntaxmesh.projectTree"
  ],
  "contributes": {
    "languages": [
      {
        "id": "syntaxmesh",
        "aliases": [
          "SyntaxMesh",
          "syntaxmesh"
        ],
        "extensions": [
          ".smx",
          ".tjp",
          ".tji"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "syntaxmesh",
        "scopeName": "source.syntaxmesh",
        "path": "./syntaxes/syntaxmesh.tmLanguage.json"
      },
      {
        "language": "syntaxmesh",
        "scopeName": "source.syntaxmesh.tji",
        "path": "./syntaxes/syntaxmesh-tji.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "syntaxmesh",
        "path": "./snippets/syntaxmesh.json"
      }
    ],
    "commands": [
      {
        "command": "syntaxmesh.project.add",
        "title": "Add Project",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.project.remove",
        "title": "Remove Project",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.project.list",
        "title": "List Projects",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.project.setActive",
        "title": "Set Active Project",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.project.refresh",
        "title": "Refresh Project",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.compile",
        "title": "Compile Project",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.checkSyntax",
        "title": "Check Syntax",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.scheduleOnly",
        "title": "Schedule Only",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.freeze",
        "title": "Freeze Project",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.checkTimeSheet",
        "title": "Check Time Sheet",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.checkStatusSheet",
        "title": "Check Status Sheet",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.run",
        "title": "Run CLI Command",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.console.open",
        "title": "Open Console",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.sheet.time.send",
        "title": "Send Time Sheets",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.sheet.time.receive",
        "title": "Receive Time Sheet",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.sheet.time.summary",
        "title": "Summarize Time Sheets",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.sheet.status.send",
        "title": "Send Status Sheets",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.sheet.status.receive",
        "title": "Receive Status Sheet",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.report.list",
        "title": "List Reports",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.report.render",
        "title": "Render Reports",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.report.open",
        "title": "Open Report",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.report.export",
        "title": "Export Report",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.help",
        "title": "Show Help",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.version",
        "title": "Show Version",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.man",
        "title": "Open Manual Command",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.exportTjp",
        "title": "Export .tjp",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.switchLanguage",
        "title": "Switch Language",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.showProjectTree",
        "title": "Show Project Tree",
        "category": "SyntaxMesh"
      },
      {
        "command": "syntaxmesh.openManual",
        "title": "Open Manual",
        "category": "SyntaxMesh"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "syntaxmesh",
          "title": "SyntaxMesh",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "syntaxmesh": [
        {
          "id": "syntaxmesh.projectTree",
          "name": "Project Explorer"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "syntaxmesh.project.add",
          "when": "view == syntaxmesh.projectTree",
          "group": "navigation"
        },
        {
          "command": "syntaxmesh.project.refresh",
          "when": "view == syntaxmesh.projectTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "syntaxmesh.project.remove",
          "when": "view == syntaxmesh.projectTree && viewItem == project",
          "group": "project"
        },
        {
          "command": "syntaxmesh.compile",
          "when": "view == syntaxmesh.projectTree && viewItem == project",
          "group": "project"
        },
        {
          "command": "syntaxmesh.report.export",
          "when": "view == syntaxmesh.projectTree && viewItem == report",
          "group": "report"
        }
      ]
    },
    "configuration": {
      "title": "SyntaxMesh",
      "properties": {
        "syntaxmesh.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the SyntaxMesh language server."
        },
        "syntaxmesh.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of diagnostics reported per document."
        },
        "syntaxmesh.locale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pt-BR",
            "es"
          ],
          "default": "auto",
          "description": "Default input language when the file has no 'language' directive. The file directive always takes precedence."
        },
        "syntaxmesh.report.defaultFormat": {
          "type": "string",
          "default": "html",
          "description": "Preferred report format in the Generate Report command."
        }
      }
    }
  }
}

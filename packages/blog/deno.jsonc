{
  "name": "@vanaware/blog",
  "version": "0.1.0",
  "description": "Blog content generator package for mdBlog",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext",
      "deno.ns",
      "deno.unstable"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.3.1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "@vanaware/blog": "./src/mod.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write tests/",
    "check": "deno check src/**/*.ts tests/**/*.ts",
    "tests": "deno task check && deno test --allow-read --allow-write tests/",
    "lint:doc": "deno run --allow-read --allow-run --allow-write --allow-env ../../scripts/lint-doc.ts src/mod.ts",
    "lint:doc:update": "deno run --allow-read --allow-run --allow-write --allow-env ../../scripts/lint-doc.ts --update src/mod.ts"
  },
  // `public/` holds build artifacts committed for the demo (the minified bundle,
  // its source map and the sample articles): machine-generated, never linted or
  // reformatted by hand.
  "lint": {
    "exclude": ["public/"]
  },
  "fmt": {
    "exclude": ["public/"]
  },
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts"
  }
}

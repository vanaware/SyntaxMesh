/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# 🔥 ARQUITETURA [PWA]: Regra Crítica!
# O Service Worker e o Manifesto JAMAIS devem ser cacheados pela CDN ou pelo Navegador.
# Isso garante que a detecção de nova versão do PWA seja imediata.
/service-worker.js
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate

# Os assets empacotados (js, css, woff2) gerados pelo Deno já possuem hash no nome, 
# então podemos deixar a Cloudflare cacheá-los no limite máximo para economia de banda.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
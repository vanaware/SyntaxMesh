{
  "name": "@syntaxmesh/service-worker",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext",
      "deno.ns",
      "webworker"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@vanaware/syntaxmesh": "../../packages/core/mod.ts",
    "@vanaware/syntaxmesh/version": "../../packages/core/src/version.ts",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/http": "jsr:@std/http@^1",
    "@std/path": "jsr:@std/path@^1",
    "idb-keyval": "https://esm.sh/idb-keyval@6.2.1",
    "fflate": "https://esm.sh/fflate@0.8.2?target=es2022",
    "fake-indexeddb": "https://esm.sh/fake-indexeddb@6.2.5?bundle",
    "fake-indexeddb/auto": "https://esm.sh/fake-indexeddb@6.2.5/auto?bundle"
  },
  "tasks": {
    "test": "deno test --allow-env --allow-net --allow-read --allow-write tests/",
    "check": "deno check src/**/*.ts tests/**/*.ts",
    "build": "deno run --allow-import --allow-read --allow-write --allow-env --allow-net --env-file --unstable-bundle ../esbuild.ts sw",
    "tests": "deno task check && deno task test",
    // `deno doc --lint` em ratchet (ADR 041): `.` e `./utils` são o mapa
    // `exports` deste pacote.
    "lint:doc": "deno run --allow-read --allow-run --allow-write --allow-env ../../scripts/lint-doc.ts src/mod.ts src/utils/mod.ts",
    "lint:doc:update": "deno run --allow-read --allow-run --allow-write --allow-env ../../scripts/lint-doc.ts --update src/mod.ts src/utils/mod.ts"
  },
  // Os antigos subcaminhos `./handshakes/*` saíram: apontavam para
  // `src/handshakes/`, que não existe mais (o gate `lint:doc` foi quem acusou).
  "exports": {
    ".": "./src/mod.ts",
    "./utils": "./src/utils/mod.ts"
  }
}

/* Variations for finance golden tests (Phase 8.8)
 *
 * Tests different chargeset distributions, charge modes, and balance orders.
 * Each taskreport block isolates one variation so the golden script can
 * extract per-scenario cost/revenue values.
 *
 * Structure follows the working tutorial pattern:
 *   - accounts/balance/rate at top-level (NOT inside project block)
 *   - account cost { account X } — NO aggregate tasks
 *   - taskreport with cost/revenue columns
 */

account cost "Project Cost" {
  account dev "Development"
  account mat "Materials"
  account misc "Misc"
}
account rev "Revenue"
balance cost rev

project prj "Variations" "1.0" 2024-08-01 - 2024-08-31 {
  timezone "Europe/Paris"
  timeformat "%Y-%m-%d"
  now 2024-08-15
  currency "USD"

  resource dev "Developers" {
    resource alice "Alice" {
      rate 400.0
    }
    resource bob "Bob" {
      rate 300.0
    }
  }
}

rate 390.0

/* ============================================================
 * Scenario 1: chargeset 100% dev (all effort charges to dev)
 * ============================================================ */
task t1_100pct "100pct dev" {
  chargeset dev
  task spec "Specification" {
    effort 10d
    allocate alice
  }
  task build "Build" {
    effort 5d
    allocate bob
    depends !spec
  }
}

taskreport report_100pct "report-100pct" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

/* ============================================================
 * Scenario 2: chargeset 70-30 split (dev 70%, mat 30%)
 * ============================================================ */
task t2_split "70-30 split" {
  chargeset dev 70, mat 30
  task spec "Specification" {
    effort 10d
    allocate alice
  }
  task build "Build" {
    effort 5d
    allocate bob
    depends !spec
  }
}

taskreport report_70_30 "report-70-30" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

/* ============================================================
 * Scenario 3: chargeset null (effort exists but charges nowhere)
 * ============================================================ */
task t3_null "null chargeset" {
  chargeset null
  task spec "Specification" {
    effort 10d
    allocate alice
  }
}

taskreport report_null "report-null" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

/* ============================================================
 * Scenario 4: charge onStart vs onEnd vs perDiem
 * ============================================================ */
task t4_charges "charge modes" {
  chargeset dev
  task milestone_start "Start Charge" {
    effort 0d
    allocate alice
    charge 1000.0 onstart
  }
  task milestone_end "End Charge" {
    effort 0d
    allocate bob
    depends !milestone_start
    charge 2000.0 onend
  }
  task work "PerDiem Work" {
    effort 5d
    allocate alice
    depends !milestone_end
    charge 500.0 perday
  }
}

taskreport report_charges "report-charges" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

/* ============================================================
 * Scenario 5: credit (negative charge) — refund
 * ============================================================ */
task t5_credit "credit test" {
  chargeset rev
  task payment "Payment" {
    effort 0d
    charge 5000.0 onend
  }
  task refund "Refund" {
    depends !payment
    charge -1500.0 onend
  }
}

taskreport report_credit "report-credit" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

/* ============================================================
 * Scenario 6: balance cost rev vs balance rev cost
 * ============================================================ */
task t6_balance "balance order" {
  chargeset dev
  task work "Work" {
    effort 10d
    allocate alice
  }
}

taskreport report_balance "report-balance" {
  formats html
  columns name, effort, cost, revenue
  balance rev cost
}
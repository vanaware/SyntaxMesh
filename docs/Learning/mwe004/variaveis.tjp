project prj "Variations" "1.0" 2024-08-01 - 2024-12-31 {
  timezone "Europe/Paris"
  timeformat "%Y-%m-%d"
  now 2024-08-15
  currency "USD"
}

rate 390.0

account cost "Project Cost" {
  account dev "Development"
  account mat "Materials"
  account misc "Misc"
}
account rev "Revenue"
balance cost rev

resource dev "Developers" {
  resource alice "Alice" {
    rate 400.0
  }
  resource bob "Bob" {
    rate 300.0
  }
}

task t1_100pct "100pct dev" {
  chargeset dev
  task spec "Specification" {
    effort 10d
    allocate alice
  }
  task build "Build" {
    effort 5d
    allocate bob
    depends !spec
  }
}

taskreport report_100pct "report-100pct" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

task t2_split "70-30 split" {
  chargeset dev 70%, mat 30%
  task spec "Specification" {
    effort 10d
    allocate alice
  }
  task build "Build" {
    effort 5d
    allocate bob
    depends !spec
  }
}

taskreport report_70_30 "report-70-30" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

task t3_purge "purge chargeset" {
  purge chargeset
  task spec "Specification" {
    effort 10d
    allocate alice
  }
}

taskreport report_null "report-null" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

task t4_charges "charge modes" {
  chargeset dev
  task milestone_start "Start Charge" {
    effort 1h
    allocate alice
    charge 1000.0 onstart
  }
  task milestone_end "End Charge" {
    effort 1h
    allocate bob
    depends !milestone_start
    charge 2000.0 onend
  }
  task work "PerDiem Work" {
    effort 5d
    allocate alice
    depends !milestone_end
    charge 500.0 perday
  }
}

taskreport report_charges "report-charges" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

task t5_credit "credit test" {
  chargeset rev
  task payment "Payment" {
    charge 5000.0 onend
  }
  task refund "Refund" {
    depends !payment
    charge 1500.0 onend
  }
}

taskreport report_credit "report-credit" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

task t6_balance "balance order" {
  chargeset dev
  task work "Work" {
    effort 10d
    allocate alice
  }
}

taskreport report_balance "report-balance" {
  formats html
  columns name, effort, cost, revenue
  balance rev cost
}

/* ============================================================
 * Scenario 7: 50-50 split (dev 50%, mat 50%)
 * ============================================================ */
task t7_split50 "50-50 split" {
  chargeset dev 50%, mat 50%
  task spec "Specification" {
    effort 10d
    allocate alice
  }
  task build "Build" {
    effort 5d
    allocate bob
    depends !spec
  }
}

taskreport report_50_50 "report-50-50" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

/* ============================================================
 * Scenario 8: perhour charge
 * ============================================================ */
task t8_perhour "perhour charge" {
  chargeset dev
  task work "Work" {
    effort 5d
    allocate alice
    charge 100.0 perhour
  }
}

taskreport report_perhour "report-perhour" {
  formats html
  columns name, effort, cost, revenue
  balance cost rev
}

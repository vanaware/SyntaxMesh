project prj "Cost & Resource Project" "1.0" 2024-08-01 - 2024-11-30 {
  timezone "Europe/Paris"
  timeformat "%Y-%m-%d"
  now 2024-09-15
  currency "USD"
}

rate 390.0

account cost "Project Cost" {
  account dev "Development"
}
account rev "Payments"
balance cost rev

resource dev "Developers" {
  resource dev1 "Paul Smith" {
    rate 350.0
  }
  resource dev2 "Sébastien Bono" {
    rate 300.0
  }
}

task AcSo "Accounting Software" {
  chargeset dev
  charge 170 perday
  responsible dev1

  task spec "Specification" {
    effort 20d
    allocate dev1, dev2
  }

  task software "Software Development" {
    depends !spec
    responsible dev1
    task database "Database coupling" {
      effort 20d
      allocate dev1, dev2
    }
    task gui "Graphical User Interface" {
      effort 35d
      depends !database
      allocate dev2
    }
  }

  task deliveries "Milestones" {
    purge chargeset
    chargeset rev

    task start "Project start" {
      start ${projectstart}
      charge 21000.0 onstart
    }
    task beta "Beta version" {
      depends !!software.gui
      charge 13000.0 onstart
    }
  }
}

taskreport overview "overview" {
  formats html
  columns bsi { title 'WBS' },
          name, start, end, effort, cost,
          revenue, chart { }
  timeformat "%a %Y-%m-%d"
  loadunit days
  hideresource @all
  balance cost rev
  caption 'All effort values are in man days.'
}

resourcereport resourceGraph "resourceGraph" {
  formats html
  headline "Resource Allocation Graph"
  columns no, name, effort, rate, weekly { }
  loadunit shortauto
  hideresource ~isleaf()
  sorttasks plan.start.up
}
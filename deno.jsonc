{
  "version": "0.0.2-mtvrt8od",
  "exports": "./esbuild.ts",
  "description": "Gerenciamento de Projetos com Linguagem Descritiva.",
  "author": "Vanaware",
  "license": "GPL-2.0-only",
  "workspace": [
    "./packages/core",
    "./packages/cli",
    "./packages/server",
    "./packages/ui",
    "./packages/service-worker",
    "./packages/blog",
    "./packages/vsextension",
    "./packages/lsp"
  ],
  // ⚙️ Configurações Rigorosas do Compilador TypeScript (FASE 4)
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  // 📦 Gerenciamento de Dependências
  "minimumDependencyAge": 60,
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.3.1",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/collections": "jsr:@std/collections@^1.3.0",
    "@vanaware/buildit": "jsr:@vanaware/buildit@^0.6.1"
  },
  "catalog": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": ["npm:esbuild@0.28.2"],
  // 🛠️ Scripts de Automação
  "tasks": {
    "test": "deno test --no-check -P",
    // 26.10 — runner consolidado: packages/*/tests/** + tests/unit/**
    // (glob de include da seção `test` abaixo).
    "test:all": "deno test --no-check -P",
    // 26.10.3 — cobertura de linhas do core a partir dos testes unitários.
    // Escopo restrito a core/tests + tests/unit: o harness e2e do CLI gera
    // subprocessos `deno` que herdariam DENO_COVERAGE_DIR e explodiriam o
    // diretório de coverage (centenas de milhares de arquivos). O único
    // subprocesso do core é ruby/tj3 (não escreve coverage deno).
    "coverage:core": "deno test --no-check -P --coverage=.tmp/cov --clean --ignore=packages/core/tests/golden packages/core/tests/ tests/unit/ && deno coverage .tmp/cov --lcov --include=packages/core/src/ --output=.tmp/core.lcov",
    // 26.11 — benchmarks do motor (bench/**/*_bench.ts, seção `bench` abaixo).
    // baseline.json é commitado; bench:compare falha com regressão > 20%.
    "bench:run": "deno bench --no-check -A",
    "bench:baseline": "deno bench --no-check -A --json > bench/baseline.json",
    "bench:compare": "deno run --no-check -A bench/compare-run.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check:all": "deno task --members check && deno check scripts/**/*.ts debug/**/*.ts",
    "fmt:check": "deno fmt --check",
    "lint:fix": "deno lint --fix",
    "lint:doc:all": "deno task --members lint:doc",
    "lint:doc:update:all": "deno task --members lint:doc:update",
    "tests": "deno task check:all && deno task lint && deno task fmt:check && deno task lint:doc:all && deno task check:doccore && deno task check:lspcore && deno task check:web-bundle && deno task check:stubs && deno task test",
    "cli": "deno run --allow-read --allow-write --allow-env packages/cli/src/cli.ts",
    "cli:test": "deno task --cwd packages/cli test",
    "cli:compile": "deno task --cwd packages/cli compile",
    "build:vsext": "deno task --cwd packages/vsextension build",
    "check:web-bundle": "deno task --cwd packages/vsextension check:web-bundle",
    "package:vsext": "deno task --cwd packages/vsextension package",
    "build:lsp": "deno task --cwd packages/lsp build",
    "generate:vsext": "deno task --cwd packages/vsextension generate",
    "golden:generate": "deno task golden:generate:ruby && deno task golden:generate:extensions && deno task golden:generate:template",
    "corpus:generate": "deno run --allow-read --allow-write ./scripts/golden/corpus.ts",
    "conformance:report": "deno run --allow-read --allow-write --allow-run ./scripts/golden/generate-report.ts",
    "snapshots:update": "UPDATE_SNAPSHOTS=1 deno test --no-check -A packages/core/tests/regression/",
    "golden:generate:ruby": "deno run --allow-read --allow-write --allow-run ./packages/core/tests/golden/generate_golden.ts",
    "golden:generate:extensions": "deno run --allow-read --allow-write ./packages/core/tests/golden/generate_extension_golden.ts",
    "golden:generate:template": "deno run --allow-read --allow-write ./packages/core/tests/golden/generate_template_expansion_golden.ts",
    "dev": "deno task --cwd packages/server dev",
    "start": "deno task --cwd packages/server start",
    "export": "deno run --allow-read --allow-write ./scripts/export.ts",
    "esbuild": "deno run -A ./scripts/esbuild.ts",
    "denobuild": "deno run --unstable-bundle -A ./scripts/denobuild.ts",
    "watch": "deno run -A ./scripts/watch.ts",
    "sanitize-version": "deno run -A ./scripts/sanitize-version.ts",
    "tag-version": "deno run -A ./scripts/tag-version.ts",
    "bump": "deno install --frozen=false && deno task esbuild dist noversion && deno task tag-version",
    "taskjuggler": "tj3 --no-color ",
    "probe": "deno run --allow-read --allow-env --allow-sys ./debug/schedule_probe.ts",
    "check:stubs": "deno run --allow-read ./scripts/check-stubs.ts",
    "check:doccore": "deno run --allow-read ./scripts/check-doccore.ts",
    "check:lspcore": "deno run --allow-read ./scripts/check-lspcore.ts",
    "gaps:audit": "deno run --allow-read ./scripts/gaps/audit.ts",
    "test:integration": "deno test --no-check -P packages/core/tests/integration/",
    "test:invariants": "deno test --no-check -P packages/core/tests/invariants/",
    "test:fuzz": "deno test --no-check -P packages/core/tests/fuzz/",
    "test:golden:scheduler": "echo 'Golden .rb do scheduler adiado para Fase 21 — coberto por tests/integration/parser-scheduler_e2e_test.ts (mwe004 dates hard-coded tj3)'; deno test --no-check -P packages/core/tests/integration/parser-scheduler_e2e_test.ts",
    "test:deferred": "deno run --allow-read ./scripts/gaps/deferred.ts",
    "gate:phase-13:partial": "deno task check:stubs && deno task gaps:audit && deno task test:deferred",
    "gate:phase-13": "deno task check:all && deno task fmt:check && deno task test && deno task test:integration && deno task test:invariants && deno task test:fuzz && deno task test:golden:scheduler && deno task check:stubs && deno task gaps:audit && deno task test:deferred",
    "blog:test": "deno test -P --allow-read --allow-write packages/blog/tests/",
    "blog:check": "deno check packages/blog/src/**/*.ts packages/blog/tests/**/*.ts",
    "blog:tests": "deno task blog:test"
  },
  "nodeModulesDir": "auto",
  "vendor": true,
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars"]
    },
    "include": [
      "scripts/**/*.ts",
      "debug/**/*.ts",
      "packages/**/src/**/*.{ts,tsx}",
      "packages/**/tests/**/*test.ts",
      "tests/unit/**/*test.ts",
      "bench/**/*.ts"
    ],
    "exclude": [
      // Cópias vendorizadas do `wz_tooltip.js` (assets dos goldens e da extensão,
      // `var` em todo o arquivo) — não é código nosso e não é editável.
      "packages/core/tests/golden/scripts/",
      "packages/vsextension/assets/scripts/"
    ]
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "net": true,
      "env": true,
      "sys": true,
      "run": true,
      "ffi": true,
      "import": true
    },
    "include": [
      "packages/**/tests/**/*test.ts",
      "tests/unit/**/*test.ts",
      "bench/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/",
      "scripts/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}"
    ]
  },
  // 26.11 — benches do motor. Só os *_bench.ts são medidos; compare.ts,
  // compare-run.ts, workloads.ts e bench_test.ts ficam de fora.
  "bench": {
    "permissions": {
      "read": true,
      "write": true,
      "net": true,
      "env": true,
      "sys": true,
      "run": true,
      "ffi": true,
      "import": true
    },
    "include": [
      "bench/**/*_bench.ts"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "trailingCommas": "always",
    "json.trailingCommas": "never",
    "operatorPosition": "maintain",
    "jsx.bracketPosition": "sameLine",
    "jsx.forceNewLinesSurroundingContent": true,
    "jsx.multiLineParens": "always",
    "newLineKind": "lf",
    "include": [
      "scripts/**/*.ts",
      "debug/**/*.ts",
      "packages/**/src/**/*.{ts,tsx}",
      "packages/**/tests/**/*test.ts",
      "tests/unit/**/*test.ts",
      "bench/**/*.ts"
    ],
    "exclude": [
      "packages/server/build/",
      // Assets vendorizados copiados para a extensão; bytes permanecem idênticos.
      "packages/vsextension/assets/"
    ]
  },
  "unstable": ["bundle"],
  "exclude": [
    ".qwen/",
    ".vscode/",
    ".github/",
    "packages/server/build/",
    "vendor",
    "node_modules",
    "snapshots",
    "docs"
  ]
}

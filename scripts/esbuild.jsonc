{
  "$schema": "https://vanaware.github.io/buildit/schema/esbuild.json",
  "versionPaths": [
    "packages/core/src/utils/version.ts",
    "packages/service-worker/src/utils/version.ts",
    "packages/ui/src/utils/version.ts"
  ],
  "forcepackagesversion": true,
  "targets": {
    "ui": {
      "default": true,
      "srcdir": "packages/ui/src",
      "distdir": "packages/server/build/dist",
      "copyFiles": [
        {
          "basedir": "packages/ui/public"
        },
        {
          "basedir": "packages/ui/src",
          "includes": [
            "index.html"
          ]
        }
      ],
      "clean": {
        "includes": [
          "*"
        ]
      },
      "entryPoints": [
        "main.tsx"
      ],
      "platform": "browser",
      "format": "esm",
      "bundle": true,
      "minify": false,
      "sourcemap": "linked",
      "conditions": [
        "browser"
      ],
      "drop": [
        "debugger"
      ],
      "jsx": "automatic",
      "jsxImportSource": "preact",
      "metafile": true,
      "write": true,
      "legalComments": "eof",
      "keepNames": true,
      "splitting": false,
      "banner": {
        "js": "/*!\n * SyntaxMesh v__APP_VERSION__\n * (c) 2026 Vanaware - MIT License\n */\n"
      }
    },
    "sw": {
      "default": true,
      "defineAssetsString": "__GENERATED_ASSETS__",
      "srcdir": "packages/service-worker/src",
      "distdir": "packages/server/build/dist",
      "clean": {
        "includes": ["service-worker.js", "service-worker.js.map"]
      },
      "entryPoints": ["service-worker.ts"],
      "platform": "browser",
      "format": "esm",
      "bundle": true,
      "minify": false,
      "sourcemap": "linked",
      "drop": ["debugger"],
      "conditions": ["worker"],
      "metafile": true,
      "write": true,
      "legalComments": "eof",
      "keepNames": true,
      "splitting": false,
      "banner": {
        "js": "/*!\n * SyntaxMesh v__APP_VERSION__\n * (c) 2026 Vanaware - MIT License\n */\n"
      }
    }
  }
}


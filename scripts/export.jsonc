{
  "$schema": "https://vanaware.github.io/buildit/schema/export.json",
  "project": "SyntaxMesh",
  "modes": {
    "ui": {
      "outputFile": "snapshots/ui.md",
      "includes": [
        "packages/ui/{src,public,tests,docs}/**/*.{tsx,jsx,js,ts,css,html,manifest,json,jsonc,md}",
        "packages/ui/{deno.json,deno.jsonc,README.md}"
      ],
      "excludes": [
        "**/node_modules/**",
        "**/.git/**"
      ],
      "includeVersion": true,
      "customInstruction": "O texto abaixo contém os arquivos de CÓDIGO FONTE principais da aplicação exemplo (UI).",
      "default": true
    },
    "docs": {
      "outputFile": "snapshots/docs.md",
      "includes": [
        "docs/syntaxmesh/**/*.{md,txt}",
        "{README.md,LICENSE,.tool-versions}"
      ],
      "excludes": [
        "**/node_modules/**",
        "**/.git/**"
      ],
      "includeVersion": false,
      "customInstruction": "O texto abaixo contém a DOCUMENTAÇÃO e diretrizes arquiteturais do projeto.",
      "default": true
    },
    "server": {
      "outputFile": "snapshots/server.md",
      "includes": [
        "packages/server/{src,tests,docs}/**/*.{tsx,jsx,js,ts,css,html,json,jsonc,yaml,yml,md}",
        "packages/server/{deno.json,deno.jsonc,README.md,.env.example}",
        ".github/workflows/**/*.{yaml,yml}"
      ],
      "excludes": [
        "**/node_modules/**",
        "**/.git/**"
      ],
      "includeVersion": true,
      "customInstruction": "O texto abaixo contém os arquivos de configuração e execução do SERVIDOR @workerdb/server e CI/CD.",
      "default": true
    },
    "sw":{
      "outputFile": "snapshots/sw.md",
      "includes": [
        "packages/service-worker/{src,tests,docs}/**/*.{tsx,jsx,js,ts,json,jsonc,md}",
        "packages/service-worker/{deno.json,deno.jsonc,README.md}"
      ],
      "excludes": [
        "**/node_modules/**",
        "**/.git/**"
      ],
      "includeVersion": true,
      "customInstruction": "O texto abaixo contém experimentos e código da área de @workerDB/service-worker",
      "default": true
    },
    "engine": {
    "outputFile": "snapshots/engine.md",
      "includes": [
        "docs/tj3-engine/**/*.{txt,md}"
      ],
      "excludes": [
        "**/node_modules/**",
        "**/.git/**"
      ],
    "includeVersion": false,
    "customInstruction":
      "O texto abaixo contém um blueprint investigativo de como funciona o motor do projeto taskjuggler, analisando seu código fonte.",
    "default": false, // ✅ Roda por padrão
  },
  "source": {
    "outputFile": "snapshots/source.md",
      "includes": [
        "docs/taskjuggler/lib/taskjuggler/**/*.rb"
      ],
      "excludes": [
        "**/node_modules/**",
        "**/.git/**"
      ],
    "includeVersion": false,
    "customInstruction":
      "O texto abaixo contém um snapshot do código fonte do projeto taskjuggler, em ruby.",
    "default": false, // ✅ Roda por padrão
  },
  "learning": {
    "outputFile": "snapshots/learning.md",
    "includes": [
        "docs/Learning/**/*.{tjp,md}"
      ],
      "excludes": [
        "**/node_modules/**",
        "**/.git/**"
      ],
    "includeVersion": false,
    "customInstruction":
      "O texto abaixo contém um snapshot de arquivos de projetos do taskjuggler, para treinamento.",
    "default": false, // ✅ Roda por padrão
  },
  "core": {
    "outputFile": "snapshots/core.md",
    "includes": [
        "packages/core/{src,tests,docs}/**/*.{tsx,jsx,js,ts,json,jsonc,md,rb}",
        "packages/core/{deno.json,deno.jsonc,README.md}"
      ],
      "excludes": [
        "**/node_modules/**",
        "**/.git/**"
      ],
    "includeVersion": false,
    "customInstruction":
      "O texto abaixo contém experimentos e código da área de @syntaxmesh/core",
    "default": true, // ✅ Roda por padrão
  },
  }
}
